def device_name(node):
    path = Path("/sys/class/input") / node / "device/name"
    try:
        return path.read_text().strip()
    except OSError:
        return ""


def key_bits(fd):
    # EVIOCGBIT(EV_KEY, 96 bytes) covers codes 0..767
    nbytes = 96
    buf = bytearray(nbytes)
    import ctypes
    ioctl_read = (2 << 30) | (ord("E") << 8) | (0x20 + EV_KEY) | (nbytes << 16)
    fcntl.ioctl(fd, ioctl_read, buf)
    found = set()
    for index in range(nbytes * 8):
        if buf[index // 8] & (1 << (index % 8)):
            found.add(index)
    return found


def open_inputs(watch_select, gamepad_codes):
    """Return {fd: set(codes)} for the PTT devices that exist right now."""
    found = {}
    for node in sorted(os.listdir("/dev/input")):
        if not node.startswith("event"):
            continue
        path = f"/dev/input/{node}"
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        except OSError:
            continue
        name = device_name(node)
        try:
            bits = key_bits(fd)
        except OSError:
            os.close(fd)
            continue
        wanted = set()
        if watch_select and name == "gpio-keys" and KEY_SELECT in bits:
            wanted.add(KEY_SELECT)
        if gamepad_codes and name.startswith("Microsoft X-Box 360 pad"):
            wanted |= gamepad_codes & bits
        if not wanted:
            os.close(fd)
            continue
        found[fd] = wanted
        log(f"listening on {path} ({name}) codes {sorted(wanted)}")
    return found


def read_keys(fd):
    try:
        data = os.read(fd, EVENT_SIZE * 64)
    except BlockingIOError:
        return []
    except OSError:
        return None
    if not data:
        return None
    keys = []
    for offset in range(0, len(data) - EVENT_SIZE + 1, EVENT_SIZE):
        typ, code, value = struct.unpack_from("HHi", data, offset + 16)
        if typ == EV_KEY and value in (0, 1):
            keys.append((code, value))
    return keys


