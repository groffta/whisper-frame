class Talker:
    def __init__(self, cfg, beeper, typer, focus):
        self.cfg = cfg
        self.beeper = beeper
        self.typer = typer
        self.focus = focus
        self.proc = None
        self.started = 0.0
        self.window_seq = None
        self.wav = STATE / "take.wav"
        self.busy = False
        self.phase = "idle"
        self.phase_fn = None

    def _phase(self, phase):
        if phase == self.phase:
            return
        self.phase = phase
        if self.phase_fn:
            self.phase_fn(phase)

    def start(self, window_seq=None):
        if self.proc or self.busy:
            return
        if self.wav.exists():
            self.wav.unlink()
        cmd = [
            "pw-record",
            "--rate", "16000",
            "--channels", "1",
            "--format", "s16",
            "--channel-map", "mono",
            "--latency", "20ms",
        ]
        target = mic_target()
        if target:
            cmd += ["--target", target]
        cmd.append(str(self.wav))
        self.proc = subprocess.Popen(
            cmd,
            env=audio_env(),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        self.started = time.monotonic()
        self.window_seq = window_seq
        self.beeper.begin()
        self.beeper.cue("start")
        log("recording")
        self._phase("record")

    def stop(self, discard=False):
        proc = self.proc
        self.proc = None
        seq = self.window_seq
        self.window_seq = None
        if not proc:
            return
        proc.send_signal(signal.SIGINT)
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait(timeout=1)
        if discard:
            log("discard short press")
            self.beeper.end()
            self._phase("idle")
            return
        self.finish(seq)

    def finish(self, window_seq=None):
        self.busy = True
        self._phase("busy")
        try:
            if not self.wav.exists():
                log("no wav")
                self.beeper.cue("error")
                return
            rms, duration = wav_stats(self.wav)
            log(f"clip {duration:.2f}s rms {rms}")
            if duration < self.cfg["min_ms"] / 1000:
                return
            if rms < self.cfg["silence_rms"]:
                log("silence")
                self.beeper.cue("empty")
                return
            text = transcribe(self.wav, self.cfg)
            if text is None:
                self.beeper.cue("error")
                return
            text = keep_text(normalize(text), rms, duration, self.cfg["silence_rms"])
            if not text:
                log("nothing to type")
                self.beeper.cue("empty")
                return
            (STATE / "last.txt").write_text(text + "\n")
            if window_seq is not None:
                self.focus.focus(window_seq)
            deliver(self.typer, text, self.cfg)
            self.beeper.cue("done")
        except Exception as exc:
            log(f"finish failed: {exc}")
            self.beeper.cue("error")
        finally:
            self.beeper.end()
            self.busy = False
            self._phase("idle")

    def recording(self):
        return self.proc is not None

    def too_long(self):
        if not self.proc:
            return False
        return (time.monotonic() - self.started) * 1000 >= self.cfg["max_ms"]


def input_signature():
    rows = []
    try:
        names = os.listdir("/dev/input")
    except OSError:
        return ()
    for node in sorted(names):
        if node.startswith("event"):
            rows.append(f"{node}:{device_name(node)}")
    return tuple(rows)


def fd_alive(fd):
    try:
        return os.fstat(fd).st_nlink > 0
    except OSError:
        return False


def control_path():
    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    return Path(runtime) / "whisper-ptt.sock"


class PanelControl:
    """Unix socket the floating-window mic panel uses to hold and release.

    A line is "hold", "hold <seq>", or "release". Hold starts recording
    immediately. A seq is the gamescope window the mic sits on, and the
    transcript is typed into that window. A hold with no seq, which is
    every hardware take, types into whatever is already focused. The
    headset button still has to pass arm_ms, and it does not steal a
    take the panel already owns.

    The daemon also writes "state idle", "state record", or "state busy"
    whenever a take changes, including one started with Select. Every
    connected panel follows that.
    """

    def __init__(self):
        path = control_path()
        path.unlink(missing_ok=True)
        listen = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        listen.bind(str(path))
        os.chmod(path, 0o600)
        listen.listen(2)
        listen.setblocking(False)
        self.path = path
        self.listen = listen
        self.clients = {}
        self.owner = False
        self.holder = None
        self.phase = "idle"
        log(f"panel socket {path}")

    def sockets(self):
        return [self.listen, *self.clients]

    def close(self):
        for conn in list(self.clients):
            self._drop(conn)
        try:
            self.listen.close()
        except OSError:
            pass
        self.path.unlink(missing_ok=True)

    def _drop(self, conn):
        self.clients.pop(conn, None)
        if conn is self.holder:
            self.holder = None
        try:
            conn.close()
        except OSError:
            pass

    def _send(self, conn, data):
        try:
            conn.sendall(data)
        except OSError:
            self._drop(conn)

    def broadcast(self, line):
        data = (line + "\n").encode()
        for conn in list(self.clients):
            self._send(conn, data)

    def publish(self, phase):
        self.phase = phase
        self.broadcast(f"state {phase}")

    def accept_ready(self):
        while True:
            try:
                conn, _ = self.listen.accept()
            except BlockingIOError:
                return
            conn.setblocking(False)
            self.clients[conn] = bytearray()
            self._send(conn, f"state {self.phase}\n".encode())

    def read_ready(self, conn, talker):
        """Return True when this client released a panel take by hanging up."""
        try:
            data = conn.recv(512)
        except BlockingIOError:
            return False
        except OSError:
            data = b""
        if not data:
            held = conn is self.holder and self.owner
            self._drop(conn)
            if held:
                self.owner = False
                log("panel hangup")
                talker.stop(discard=False)
            return held
        buf = self.clients.get(conn)
        if buf is None:
            return False
        buf.extend(data)
        while b"\n" in buf:
            line, _, rest = buf.partition(b"\n")
            del buf[: len(line) + 1]
            self._command(conn, line.decode("ascii", "replace").strip(), talker)
        return False

    def _command(self, conn, line, talker):
        parts = line.split()
        if parts[:1] == ["hold"] and len(parts) <= 2:
            seq = None
            if len(parts) == 2:
                if not parts[1].isdigit():
                    self._send(conn, b"no\n")
                    return
                seq = int(parts[1])
            if self.owner or talker.recording() or talker.busy:
                self._send(conn, b"busy\n")
                return
            self.owner = True
            self.holder = conn
            talker.start(seq)
            log(f"panel hold {seq}" if seq is not None else "panel hold")
            self._send(conn, b"ok\n")
            return
        if line == "release":
            if self.owner and conn is self.holder:
                self.owner = False
                self.holder = None
                log("panel release")
                talker.stop(discard=False)
            self._send(conn, b"ok\n")
            return
        self._send(conn, b"no\n")


def run_daemon():
    if not BIN.exists() or not MODEL.exists():
        raise SystemExit(f"missing {BIN} or {MODEL}")
    STATE.mkdir(parents=True, exist_ok=True)
    lock_fd = os.open(LOCK, os.O_CREAT | os.O_RDWR, 0o644)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        raise SystemExit("whisper-ptt is already running")
    cfg = load_config()
    watch_select, gamepad_codes = wanted_codes(cfg["button"])
    ensure_cues()
    typer = Typer()
    beeper = Beeper()
    talker = Talker(cfg, beeper, typer, WindowFocus())
    log(
        f"whisper small ready, button={cfg['button']}, "
        f"lang={cfg['language']}, threads={cfg['threads']}, gpu=vulkan, "
        f"arm_ms={cfg['arm_ms']}"
    )
    fds = {}
    held = set()
    pending = None
    pending_at = 0.0
    starter = None
    signature = None
    panel = PanelControl()
    talker.phase_fn = panel.publish

    def rescan(force=False):
        nonlocal fds, signature, starter, held, pending, pending_at
        current = input_signature()
        dead = [fd for fd in fds if not fd_alive(fd)]
        if not force and current == signature and not dead:
            return
        if talker.recording():
            log("input changed while recording, finishing this clip")
            starter = None
            held = set()
            pending = None
            panel.owner = False
            panel.holder = None
            talker.stop(discard=False)
        else:
            beeper.end()
        for fd in list(fds):
            os.close(fd)
        fds = open_inputs(watch_select, gamepad_codes)
        signature = current
        held = set()
        pending = None
        pending_at = 0.0
        starter = None

    def arm_pending():
        nonlocal pending, starter
        if panel.owner or pending is None or starter is not None or talker.recording() or talker.busy:
            return
        if (time.monotonic() - pending_at) * 1000 < cfg["arm_ms"]:
            return
        starter = pending
        pending = None
        log(f"long press {CODE_NAMES.get(starter[1], starter[1])} {cfg['arm_ms']}ms")
        talker.start()

    rescan(force=True)
    while True:
        rescan()
        timeout = 0.2 if talker.recording() else 0.5
        if pending is not None and not talker.busy:
            remain = (cfg["arm_ms"] / 1000) - (time.monotonic() - pending_at)
            timeout = 0 if remain <= 0 else min(timeout, max(0.02, remain))
        sockets = {sock.fileno(): sock for sock in panel.sockets()}
        readable, _, _ = select.select(list(fds) + list(sockets), [], [], timeout)
        for fd in readable:
            sock = sockets.get(fd)
            if sock is not None:
                if sock is panel.listen:
                    panel.accept_ready()
                else:
                    panel.read_ready(sock, talker)
                if panel.owner and pending is not None:
                    pending = None
                continue
            events = read_keys(fd)
            if events is None:
                if pending and pending[0] == fd:
                    pending = None
                    beeper.end()
                if starter and starter[0] == fd:
                    starter = None
                    talker.stop(discard=False)
                held = {token for token in held if token[0] != fd}
                os.close(fd)
                fds.pop(fd, None)
                signature = None
                continue
            codes = fds.get(fd, set())
            for code, value in events:
                if code not in codes:
                    continue
                token = (fd, code)
                if value == 1:
                    held.add(token)
                    if (
                        starter is None
                        and pending is None
                        and not talker.busy
                        and not panel.owner
                        and not talker.recording()
                    ):
                        pending = token
                        pending_at = time.monotonic()
                        beeper.begin()
                elif value == 0:
                    held.discard(token)
                    if token == pending:
                        pending = None
                        beeper.end()
                        log(f"short click {CODE_NAMES.get(code, code)}")
                    elif token == starter:
                        short = (time.monotonic() - talker.started) * 1000 < cfg["min_ms"]
                        starter = None
                        talker.stop(discard=short)
        arm_pending()
        if talker.too_long():
            log("max length, transcribing")
            starter = None
            pending = None
            panel.owner = False
            panel.holder = None
            talker.stop(discard=False)
            held.clear()



def deliver(typer, text, cfg):
    leading, body, trailing = parse_actions(text)
    display, window = typer.focused_target()
    for name in leading:
        ok = typer.run_action(name, display)
        log(f"action {name} {'ok' if ok else 'failed'}")
    typed = 0
    if body:
        press_enter = cfg["enter"] and "submit" not in trailing
        typed = typer.type_text(
            body, display, window, cfg["append_space"], press_enter,
        )
        log(f"typed {typed} chars on {display} window {window}: {body}")
    for name in trailing:
        ok = typer.run_action(name, display)
        log(f"action {name} {'ok' if ok else 'failed'}")
    if not body:
        shown = leading + trailing
        log(f"actions only: {', '.join(shown) if shown else 'none'}")
    return typed


def device_name_of(fd):
    try:
        link = os.readlink(f"/proc/self/fd/{fd}")
    except OSError:
        return ""
    node = os.path.basename(link)
    return device_name(node)


def once(path, cfg, do_type):
    wav = Path(path)
    rms, duration = wav_stats(wav)
    log(f"file {wav} {duration:.2f}s rms {rms}")
    text = transcribe(wav, cfg)
    if text is None:
        raise SystemExit(1)
    text = keep_text(normalize(text), rms, duration, 0)
    print(text)
    if do_type and text:
        deliver(Typer(), text, cfg)


def main(argv):
    cfg = load_config()
    if len(argv) >= 2 and argv[1] == "--self-test":
        Typer().self_test()
        return
    if len(argv) >= 3 and argv[1] == "--once":
        once(argv[2], cfg, "--type" in argv)
        return
    if len(argv) >= 2 and argv[1] == "--devices":
        watch_select, gamepad_codes = wanted_codes(cfg["button"])
        open_inputs(watch_select, gamepad_codes)
        return
    run_daemon()


if __name__ == "__main__":
    main(sys.argv)
