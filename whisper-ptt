        self.x11.XSync.argtypes = [ctypes_c_void_p(), ctypes_c_int()]
        self.x11.XDisplayKeycodes.argtypes = [
            ctypes_c_void_p(), ctypes_ptr_int(), ctypes_ptr_int(),
        ]
        self.x11.XkbKeycodeToKeysym.restype = ctypes_c_ulong()
        self.x11.XkbKeycodeToKeysym.argtypes = [
            ctypes_c_void_p(), ctypes_c_ubyte(), ctypes_c_int(), ctypes_c_int(),
        ]
        self.x11.XGetWindowAttributes.argtypes = [
            ctypes_c_void_p(), ctypes_c_ulong(), ctypes_c_void_p(),
        ]
        self.x11.XGetInputFocus.argtypes = [
            ctypes_c_void_p(), ctypes_ptr_ulong(), ctypes_ptr_int(),
        ]
        self.x11.XSetInputFocus.argtypes = [
            ctypes_c_void_p(), ctypes_c_ulong(), ctypes_c_int(), ctypes_c_ulong(),
        ]
        self.x11.XCreateSimpleWindow.restype = ctypes_c_ulong()
        self.x11.XCreateSimpleWindow.argtypes = [
            ctypes_c_void_p(), ctypes_c_ulong(),
            ctypes_c_int(), ctypes_c_int(),
            ctypes_c_uint(), ctypes_c_uint(), ctypes_c_uint(),
            ctypes_c_ulong(), ctypes_c_ulong(),
        ]
        self.x11.XSelectInput.argtypes = [
            ctypes_c_void_p(), ctypes_c_ulong(), ctypes_c_long(),
        ]
        self.x11.XMapWindow.argtypes = [ctypes_c_void_p(), ctypes_c_ulong()]
        self.x11.XDestroyWindow.argtypes = [ctypes_c_void_p(), ctypes_c_ulong()]
        self.x11.XGrabKeyboard.restype = ctypes_c_int()
        self.x11.XGrabKeyboard.argtypes = [
            ctypes_c_void_p(), ctypes_c_ulong(), ctypes_c_int(),
            ctypes_c_int(), ctypes_c_int(), ctypes_c_ulong(),
        ]
        self.x11.XUngrabKeyboard.argtypes = [ctypes_c_void_p(), ctypes_c_ulong()]
        self.x11.XPending.restype = ctypes_c_int()
        self.x11.XPending.argtypes = [ctypes_c_void_p()]
        self.x11.XNextEvent.argtypes = [ctypes_c_void_p(), ctypes_c_void_p()]
        self.xtst.XTestQueryExtension.argtypes = [
            ctypes_c_void_p(), ctypes_ptr_int(), ctypes_ptr_int(),
            ctypes_ptr_int(), ctypes_ptr_int(),
        ]
        self.xtst.XTestFakeKeyEvent.argtypes = [
            ctypes_c_void_p(), ctypes_c_uint(), ctypes_c_int(), ctypes_c_ulong(),
        ]
        self._handler = ctypes_error_handler()(lambda *_: 0)
        self.x11.XSetErrorHandler(self._handler)
        self.x11.XSetIOErrorHandler.argtypes = [
            ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_void_p),
        ]
        self.x11.XSetIOErrorHandler.restype = ctypes.c_void_p
        self._io_handler = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_void_p)(self._io_error)
        self.x11.XSetIOErrorHandler(self._io_handler)
        self.displays = {}
        self.maps = {}
        self.tokens = {}
        # Characters actually injected, in order. Clear sends one
        # backspace per entry. Submit drops the buffer: Enter committed it.
        self.sent = []

    def _io_error(self, _display):
        # Xlib requires this handler not to return. A dead socket would
        # otherwise abort inside XFlush and skip the service restart.
        log("display connection closed")
        os._exit(1)
        return 0

    def display(self, name):
        token = x_socket_token(name)
        cached = self.displays.get(name)
        if cached and token is not None and self.tokens.get(name) == token:
            return cached
        if cached:
            # The server was replaced. Closing the old pointer calls back
            # into the dead socket, so drop it and open the new one.
            log(f"display {name} restarted")
            self.displays.pop(name, None)
            self.maps.pop(name, None)
        opened = self.x11.XOpenDisplay(name.encode())
        if not opened:
            raise OSError(f"cannot open {name}")
        self.displays[name] = opened
        self.tokens[name] = token
        return opened

    def keymap(self, name):
        cached = self.maps.get(name)
        if cached:
            return cached
        dpy = self.display(name)
        low = ctypes.c_int()
        high = ctypes.c_int()
        self.x11.XDisplayKeycodes(dpy, ctypes.byref(low), ctypes.byref(high))
        table = {}
        for keycode in range(low.value, high.value + 1):
            for level in range(4):
                keysym = self.x11.XkbKeycodeToKeysym(dpy, keycode, 0, level)
                if keysym and keysym not in table:
                    table[keysym] = (keycode, level)
        self.maps[name] = table
        return table

    def window_on(self, name, window):
        if not window:
            return False
        try:
            dpy = self.display(name)
        except OSError:
            return False
        buf = ctypes.create_string_buffer(512)
        return self.x11.XGetWindowAttributes(
            dpy, window, ctypes.cast(buf, ctypes.c_void_p)
        ) != 0

    def focused_target(self):
        window = gamescope_window()
        for name in (":1", ":0"):
            if self.window_on(name, window):
                return name, window
        for name in (":0", ":1"):
            try:
                dpy = self.display(name)
            except OSError:
                continue
            focus = ctypes.c_ulong()
            revert = ctypes.c_int()
            self.x11.XGetInputFocus(dpy, ctypes.byref(focus), ctypes.byref(revert))
            if focus.value and focus.value != 0:
                return name, focus.value
        return ":0", 0

    def type_text(self, text, display, window, append_space, press_enter):
        dpy = self.display(display)
        table = self.keymap(display)
        # Gamescope keeps X focus on the real window. XSetInputFocus does not
        # move it, so keys are injected at the display that already has focus.
        del window
        shift = table.get(XK_SHIFT_L)
        if shift:
            self._key(dpy, shift[0], False)
        typed = 0
        payload = text
        if append_space and payload and not payload.endswith(" "):
            payload += " "
        if press_enter:
            payload += "\n"
        for char in payload:
            keysym = XK_RETURN if char == "\n" else ord(char)
            info = table.get(keysym)
            if not info:
                log(f"no keysym for {char!r}")
                continue
            keycode, level = info
            if level not in (0, 1):
                continue
            if level == 1 and shift:
                self._key(dpy, shift[0], True)
            self._key(dpy, keycode, True)
            self._key(dpy, keycode, False)
            self.x11.XFlush(dpy)
            if level == 1 and shift:
                self._key(dpy, shift[0], False)
            self.sent.append(char)
            typed += 1
        self.x11.XFlush(dpy)
        return typed

    def _tap(self, dpy, table, keysym):
        info = table.get(keysym)
        if not info or info[1] not in (0, 1):
            log(f"no keysym for {keysym:#x}")
            return False
        shift = table.get(XK_SHIFT_L)
        if info[1] == 1 and shift:
            self._key(dpy, shift[0], True)
        self._key(dpy, info[0], True)
        self._key(dpy, info[0], False)
        if info[1] == 1 and shift:
            self._key(dpy, shift[0], False)
        self.x11.XFlush(dpy)
        return True

    def _chord(self, dpy, table, modifier, keysym):
        mod = table.get(modifier)
        info = table.get(keysym)
        if not mod or not info or info[1] not in (0, 1):
            log(f"no keysym for chord {modifier:#x} {keysym:#x}")
            return False
        self._key(dpy, mod[0], True)
        try:
            if info[1] == 1:
                shift = table.get(XK_SHIFT_L)
                if shift:
                    self._key(dpy, shift[0], True)
            self._key(dpy, info[0], True)
            self._key(dpy, info[0], False)
            if info[1] == 1:
                shift = table.get(XK_SHIFT_L)
                if shift:
                    self._key(dpy, shift[0], False)
        finally:
            self._key(dpy, mod[0], False)
        self.x11.XFlush(dpy)
        return True

    def run_action(self, name, display):
        dpy = self.display(display)
        table = self.keymap(display)
        shift = table.get(XK_SHIFT_L)
        if shift:
            self._key(dpy, shift[0], False)
        if name == "clear":
            return self._backspace_sent(dpy, table)
        if name == "submit":
            ok = self._tap(dpy, table, XK_RETURN)
            if ok:
                self.sent.clear()
            return ok
        log(f"unknown action {name}")
        return False

    def _backspace_sent(self, dpy, table):
        count = 0
        while self.sent:
            if not self._tap(dpy, table, XK_BACKSPACE):
                log(f"clear stopped after {count} backspaces, {len(self.sent)} left")
                return False
            self.sent.pop()
            count += 1
        log(f"clear {count} backspaces")
        return True

    def _key(self, dpy, keycode, down):
        self.xtst.XTestFakeKeyEvent(dpy, keycode, 1 if down else 0, 12)

    def self_test(self):
        name = ":0"
        dpy = self.display(name)
        event = ctypes.c_int()
        error = ctypes.c_int()
        major = ctypes.c_int()
        minor = ctypes.c_int()
        if not self.xtst.XTestQueryExtension(
            dpy, ctypes.byref(event), ctypes.byref(error),
            ctypes.byref(major), ctypes.byref(minor),
        ):
            raise SystemExit("XTest extension missing on :0")
        root = root_window(name)
        focus = ctypes.c_ulong()
        revert = ctypes.c_int()
        self.x11.XGetInputFocus(dpy, ctypes.byref(focus), ctypes.byref(revert))
        window = self.x11.XCreateSimpleWindow(dpy, root, 0, 0, 8, 8, 0, 0, 0)
        self.x11.XSelectInput(dpy, window, KEY_PRESS_MASK)
        self.x11.XMapWindow(dpy, window)
        self.x11.XSync(dpy, False)
        time.sleep(0.15)
        # Grab so the probe keys cannot land in the user's focused window.
        # Gamescope ignores XSetInputFocus, which is why production just types
        # into whichever window already has focus. GrabNotViewable (3) means
        # the map has not landed yet, so try once more.
        status = self.x11.XGrabKeyboard(dpy, window, True, 1, 1, CURRENT_TIME)
        if status == 3:
            time.sleep(0.2)
            status = self.x11.XGrabKeyboard(dpy, window, True, 1, 1, CURRENT_TIME)
        if status != 0:
            self.x11.XDestroyWindow(dpy, window)
            raise SystemExit(f"keyboard grab failed ({status})")
        try:
            typed = self.type_text("ok", name, 0, False, False)
            self.x11.XSync(dpy, False)
            time.sleep(0.25)
            got = 0
            event_buf = ctypes.create_string_buffer(512)
            while self.x11.XPending(dpy):
                self.x11.XNextEvent(dpy, ctypes.cast(event_buf, ctypes.c_void_p))
                kind = struct.unpack_from("i", event_buf.raw, 0)[0]
                if kind == 2:
                    got += 1
        finally:
            self.x11.XUngrabKeyboard(dpy, CURRENT_TIME)
            self.x11.XDestroyWindow(dpy, window)
            self.x11.XFlush(dpy)
        log(f"xtest self-test typed {typed} keys, grab window saw {got}")
        if got < 2:
            raise SystemExit("XTest keys did not reach the grab window")
        return True


