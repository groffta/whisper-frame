def root_window(display):
    out = subprocess.check_output(
        ["xwininfo", "-root", "-display", display],
        text=True,
        timeout=3,
    )
    match = re.search(r"Window id: (0x[0-9a-fA-F]+)", out)
    if not match:
        raise OSError(f"no root window on {display}")
    return int(match.group(1), 16)


def x_socket_token(name):
    """Identity of the X server socket. A new inode means the server restarted."""
    if not name.startswith(":"):
        return None
    path = f"/tmp/.X11-unix/X{name[1:]}"
    try:
        st = os.stat(path)
    except OSError:
        return None
    return (st.st_dev, st.st_ino)


def gamescope_window():
    try:
        out = subprocess.check_output(
            ["xprop", "-display", ":0", "-root", "GAMESCOPE_FOCUSED_WINDOW"],
            text=True,
            timeout=3,
            env={**audio_env(), "DISPLAY": ":0"},
        )
    except (OSError, subprocess.SubprocessError):
        return 0
    match = re.search(r"=\s*(\d+)", out)
    if not match:
        return 0
    return int(match.group(1))


OPENVR = "/opt/steamvr/bin/linuxarm64/libopenvr_api.so"
# gamescope moves its keyboard connector when it receives this event for
# one of its window overlays. It is not in the public OpenVR headers.
OVERLAY_INPUT_FOCUS = 564


def _norm_title(title):
    title = (title or "").strip()
    while title and 0x2800 <= ord(title[0]) <= 0x28FF:
        title = title[1:].lstrip()
    return title


def window_title(xid):
    if not xid:
        return ""
    try:
        prop = subprocess.check_output(
            ["xprop", "-display", ":0", "-id", hex(xid), "_NET_WM_NAME"],
            text=True,
            timeout=2,
            stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    if "=" not in prop:
        return ""
    raw = prop.split("=", 1)[1].strip()
    if len(raw) >= 2 and raw[0] == '"' and raw[-1] == '"':
        raw = raw[1:-1]
    return raw


def windows_named(title):
    """X ids whose xwininfo title matches. Empty when the name is missing or the list could not be read."""
    wanted = _norm_title(title)
    if not wanted:
        return []
    try:
        out = subprocess.check_output(
            ["xwininfo", "-display", ":0", "-root", "-children"],
            text=True,
            timeout=2,
        )
    except (OSError, subprocess.SubprocessError):
        return []
    found = []
    for line in out.splitlines():
        match = re.match(r'\s*(0x[0-9a-fA-F]+)\s+"(.*)"\s*:', line)
        if not match:
            continue
        if _norm_title(match.group(2)) == wanted:
            found.append(int(match.group(1), 16))
    return found


class WindowFocus:
    """Move gamescope keyboard focus to the floating window a mic is on.

    IVROverlayView.PostOverlayEvent delivers the event to the process that
    owns that window overlay. gamescope then switches its keyboard connector.
    """

    def __init__(self):
        self._lib = None
        self._find = None
        self._name = None
        self._post = None
        self._u64 = ctypes.c_uint64

    def focus(self, seq):
        try:
            return self._focus(seq)
        except Exception as exc:
            log(f"focus window {seq} failed ({exc})")
            lib = self._lib
            self._lib = None
            self._find = None
            self._name = None
            self._post = None
            if lib is not None:
                try:
                    lib.VR_ShutdownInternal()
                except Exception:
                    pass
            return False

    def _open(self):
        if self._post is not None:
            return True
        if not Path(OPENVR).exists():
            log("focus unavailable")
            return False
        lib = ctypes.CDLL(OPENVR)
        err = ctypes.c_int(0)
        lib.VR_InitInternal.argtypes = [ctypes.POINTER(ctypes.c_int), ctypes.c_int]
        lib.VR_InitInternal.restype = ctypes.c_uint32
        lib.VR_InitInternal(ctypes.byref(err), 2)
        if err.value != 0:
            log(f"OpenVR init failed ({err.value})")
            return False
        lib.VR_ShutdownInternal.argtypes = []
        lib.VR_GetGenericInterface.argtypes = [ctypes.c_char_p, ctypes.POINTER(ctypes.c_int)]
        lib.VR_GetGenericInterface.restype = ctypes.c_void_p
        err = ctypes.c_int(0)
        table = lib.VR_GetGenericInterface(b"FnTable:IVROverlay_028", ctypes.byref(err))
        if err.value or not table:
            lib.VR_ShutdownInternal()
            log(f"overlay interface failed ({err.value})")
            return False
        err = ctypes.c_int(0)
        view = lib.VR_GetGenericInterface(b"FnTable:IVROverlayView_003", ctypes.byref(err))
        if err.value or not view:
            lib.VR_ShutdownInternal()
            log(f"overlay view interface failed ({err.value})")
            return False
        fns = ctypes.cast(table, ctypes.POINTER(ctypes.c_void_p))
        views = ctypes.cast(view, ctypes.POINTER(ctypes.c_void_p))
        u64 = self._u64
        self._find = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_char_p, ctypes.POINTER(u64))(fns[0])
        self._name = ctypes.CFUNCTYPE(
            ctypes.c_int, u64, ctypes.c_char_p, ctypes.c_uint32, ctypes.POINTER(ctypes.c_int)
        )(fns[5])
        self._post = ctypes.CFUNCTYPE(None, u64, ctypes.c_void_p)(views[2])
        self._lib = lib
        return True

    def _focus(self, seq):
        if not self._open():
            return False
        key = f"gamescope.gamescope-0.window.{seq}".encode()
        handle = self._u64(0)
        if self._find(key, ctypes.byref(handle)) != 0 or not handle.value:
            log(f"focus window {seq} is gone")
            return False
        buf = ctypes.create_string_buffer(512)
        nerr = ctypes.c_int(0)
        self._name(handle, buf, 512, ctypes.byref(nerr))
        title = _norm_title(buf.value.decode("utf-8", "replace"))
        before = gamescope_window()
        named = windows_named(title)
        if len(named) == 1 and named[0] == before:
            log(f"focus window {seq} already")
            return True
        event = bytearray(128)
        event[0:4] = OVERLAY_INPUT_FOCUS.to_bytes(4, "little")
        event[12:20] = int(handle.value).to_bytes(8, "little")
        event[20:24] = (1).to_bytes(4, "little")
        raw = (ctypes.c_char * len(event)).from_buffer(event)
        self._post(handle, raw)
        deadline = time.monotonic() + 0.35
        while time.monotonic() < deadline:
            now = gamescope_window()
            if now and now != before:
                log(f"focus window {seq}")
                return True
            time.sleep(0.02)
        named = windows_named(title)
        if len(named) == 1 and named[0] == gamescope_window():
            log(f"focus window {seq} already")
            return True
        log(f"focus window {seq} stayed on {before:#x}")
        return False


