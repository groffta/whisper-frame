def log(msg):
    print(f"{time.strftime('%H:%M:%S')} {msg}", flush=True)


def audio_env():
    env = os.environ.copy()
    runtime = env.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    env["XDG_RUNTIME_DIR"] = runtime
    env.setdefault("DBUS_SESSION_BUS_ADDRESS", f"unix:path={runtime}/bus")
    return env


def load_config():
    CONF_DIR.mkdir(parents=True, exist_ok=True)
    if not CONF.exists():
        CONF.write_text(DEFAULT_CONF)
    cfg = {
        "button": "select",
        "language": "en",
        "threads": 4,
        "append_space": True,
        "enter": False,
        "min_ms": 280,
        "arm_ms": 300,
        "max_ms": 28000,
        "silence_rms": 30,
    }
    for raw in CONF.read_text().splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line or "=" not in line:
            continue
        key, val = (part.strip() for part in line.split("=", 1))
        low = val.lower()
        if key in ("append_space", "enter"):
            cfg[key] = low in ("1", "yes", "true", "on")
        elif key in ("threads", "min_ms", "arm_ms", "max_ms", "silence_rms"):
            cfg[key] = int(val)
        elif key in cfg:
            cfg[key] = val
    return cfg


def wanted_codes(button):
    """Return (watch_select, gamepad_codes)."""
    parts = re.split(r"[+, ]+", button.strip().lower())
    if parts == ["both"]:
        parts = ["select"]
    select = False
    codes = set()
    for part in parts:
        if not part:
            continue
        if part == "select":
            select = True
        elif part in GAMEPAD_BUTTONS:
            codes.add(GAMEPAD_BUTTONS[part])
        else:
            raise SystemExit(f"unknown button {part!r} in {CONF}")
    return select, codes


def write_tone(path, freq, ms, volume=0.18):
    rate = 16000
    count = int(rate * ms / 1000)
    fade = max(1, int(rate * 0.006))
    frames = bytearray()
    for i in range(count):
        env = 1.0
        if i < fade:
            env = i / fade
        elif i > count - fade:
            env = max(0.0, (count - i) / fade)
        sample = int(volume * env * 32767 * math.sin(2 * math.pi * freq * i / rate))
        frames += struct.pack("<h", max(-32767, min(32767, sample)))
    with wave.open(str(path), "w") as handle:
        handle.setnchannels(1)
        handle.setsampwidth(2)
        handle.setframerate(rate)
        handle.writeframes(frames)


def ensure_cues():
    STATE.mkdir(parents=True, exist_ok=True)
    cues = {
        "start": (1320, 42),
        "done": (880, 49),
        "empty": (420, 77),
        "error": (220, 112),
    }
    paths = {}
    for name, (freq, ms) in cues.items():
        path = STATE / f"{name}.wav"
        if not path.exists():
            write_tone(path, freq, ms)
        paths[name] = path
    return paths


class Beeper:
    """Play cues on a stream that is already running.

    The default playback sink suspends after a few quiet seconds. A fresh
    short pw-cat exits while the sink is still waking, so the beep is audible
    only when some other stream has already opened it. A hold opens the stream
    early. The tone is written once the sink is up, and the stream stays open
    long enough for the buffer to drain.
    """

    RATE = 48000

    def __init__(self):
        frames = self.RATE * 20 // 1000
        self.silence = bytes(frames * 4)
        self.cues = {
            "start": self._tone(1320, 126, 0.50),
            "done": self._tone(880, 105, 0.45),
            "empty": self._tone(420, 126, 0.45),
            "error": self._tone(220, 154, 0.50),
        }
        self.cv = threading.Condition()
        self.queue = []
        self.hold = False
        self.hold_at = 0.0
        self.tail = 0
        self.sound = False
        self.proc = None
        self.stop = False
        threading.Thread(target=self._loop, name="beep", daemon=True).start()

    def begin(self):
        with self.cv:
            if not self.hold:
                self.hold = True
                self.hold_at = time.monotonic()
            self.cv.notify()

    def cue(self, kind):
        with self.cv:
            self.queue.append(self.cues[kind])
            self.sound = True
            self.cv.notify()
        log(f"beep {kind}")

    def end(self):
        with self.cv:
            self.hold = False
            if self.sound or self.queue:
                self.tail = max(self.tail, 25)
            else:
                self.tail = 0
            self.cv.notify()

    def _tone(self, freq, ms, volume):
        count = int(self.RATE * ms / 1000)
        fade = max(1, int(self.RATE * 0.008))
        frames = bytearray()
        for i in range(count):
            env = 1.0
            if i < fade:
                env = i / fade
            elif i > count - fade:
                env = max(0.0, (count - i) / fade)
            sample = int(volume * env * 32767 * math.sin(2 * math.pi * freq * i / self.RATE))
            sample = max(-32767, min(32767, sample))
            frames += struct.pack("<hh", sample, sample)
        return bytes(frames)

    def _spawn(self):
        return subprocess.Popen(
            [
                "pw-cat", "--playback", "--raw",
                "--format", "s16",
                "--rate", str(self.RATE),
                "--channels", "2",
                "--latency", "20ms",
                "-",
            ],
            stdin=subprocess.PIPE,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            env=audio_env(),
            bufsize=0,
        )

    def _close_proc(self, proc):
        if not proc:
            return
        try:
            if proc.stdin:
                proc.stdin.close()
        except OSError:
            pass
        try:
            proc.wait(timeout=1)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait(timeout=1)

    def _loop(self):
        while not self.stop:
            proc_to_close = None
            with self.cv:
                chunk = None
                if self.queue:
                    chunk = self.queue.pop(0)
                    self.tail = 25
                elif self.hold or self.tail > 0:
                    waited = time.monotonic() - self.hold_at
                    if self.proc is None and not self.sound and waited < 0.12:
                        self.cv.wait(timeout=0.04)
                        continue
                    if not self.hold and self.tail > 0:
                        self.tail -= 1
                        if self.tail == 0:
                            self.sound = False
                    chunk = self.silence
                else:
                    proc_to_close = self.proc
                    self.proc = None
                    self.sound = False
            if proc_to_close is not None:
                self._close_proc(proc_to_close)
            if chunk is None:
                with self.cv:
                    if not self.hold and not self.queue and self.tail == 0:
                        self.cv.wait(timeout=0.2)
                continue
            proc = self.proc
            if proc is None or proc.poll() is not None:
                if proc is not None:
                    self._close_proc(proc)
                try:
                    proc = self._spawn()
                except OSError as exc:
                    log(f"beep failed: {exc}")
                    time.sleep(0.2)
                    continue
                with self.cv:
                    self.proc = proc
            try:
                proc.stdin.write(chunk)
            except (BrokenPipeError, OSError) as exc:
                log(f"beep failed: {exc}")
                self._close_proc(proc)
                with self.cv:
                    if self.proc is proc:
                        self.proc = None




def mic_target():
    builtin = "alsa_loopback_device.alsa_input.platform-sound.HiFi__Mic__source"
    try:
        out = subprocess.check_output(
            ["pactl", "list", "short", "sources"],
            env=audio_env(),
            text=True,
            timeout=3,
        )
    except (OSError, subprocess.SubprocessError):
        return builtin
    if builtin in out:
        return builtin
    for line in out.splitlines():
        cols = line.split()
        if len(cols) >= 2 and "monitor" not in cols[1] and "bluez" not in cols[1]:
            return cols[1]
    return None


def wav_stats(path):
    with wave.open(str(path)) as handle:
        frames = handle.getnframes()
        width = handle.getsampwidth()
        rate = handle.getframerate() or 1
        raw = handle.readframes(frames)
    if width != 2 or not raw:
        return 0, 0.0
    samples = array.array("h")
    samples.frombytes(raw[: len(raw) // 2 * 2])
    if sys.byteorder != "little":
        samples.byteswap()
    if not samples:
        return 0, 0.0
    total = 0
    for sample in samples:
        total += sample * sample
    rms = int((total / len(samples)) ** 0.5)
    return rms, frames / rate


def normalize(text):
    text = text.translate({
        0x2018: "'",
        0x2019: "'",
        0x201C: '"',
        0x201D: '"',
        0x2013: "-",
        0x2014: "-",
        0x2026: "...",
    })
    text = text.replace("\n", " ").replace("\t", " ")
    text = re.sub(r"\s+", " ", text).strip()
    if re.fullmatch(r"[\[(][^)\]]+[\])]", text or ""):
        return ""
    return text


# A verb here is an action, not text, when it is the whole transcript or the
# first or last word. The same word in the middle is left alone.
ACTIONS = {
    "clear": "clear",
    "submit": "submit",
}


def _trim_separator(body, front):
    body = body.strip()
    if front:
        return re.sub(r"^[,:;]+\s*", "", body).strip()
    return re.sub(r"[,:;]+\s*$", "", body).strip()


def _peel_front(text):
    match = re.match(
        r"^['\"]*([A-Za-z']+)['\"]*([.!?:,;]*)(?:\s+(.*))?$",
        text,
    )
    if not match:
        return None, text
    action = ACTIONS.get(match.group(1).lower())
    if not action:
        return None, text
    return action, (match.group(3) or "").strip()


def _peel_back(text):
    match = re.match(
        r"^(.*)(?<!\S)['\"]*([A-Za-z']+)['\"]*([.!?:,;]*)$",
        text,
    )
    if not match:
        return None, text
    action = ACTIONS.get(match.group(2).lower())
    if not action:
        return None, text
    return action, _trim_separator(match.group(1), front=False)


def parse_actions(text):
    """Return (leading actions, typed body, trailing actions)."""
    leading = []
    trailing = []
    body = text.strip()
    while body:
        action, rest = _peel_front(body)
        if not action or rest == body:
            break
        leading.append(action)
        body = rest
    while body:
        action, rest = _peel_back(body)
        if not action or rest == body:
            break
        trailing.append(action)
        body = rest
    trailing.reverse()
    return leading, body.strip(), trailing


def keep_text(text, rms, duration, silence_rms):
    folded = text.strip().lower()
    if folded in ALWAYS_DROP:
        return ""
    if rms < silence_rms:
        return ""
    if folded in QUIET_DROP and (duration < 1.0 or rms < 400):
        return ""
    return text


def transcribe(wav, cfg):
    out_base = STATE / "last"
    for suffix in (".txt", ".wav"):
        # last.wav is the take; last.txt is whisper's output. Don't delete the take.
        pass
    txt = Path(str(out_base) + ".txt")
    if txt.exists():
        txt.unlink()
    cmd = [
        "taskset", "-c", "2-7",
        str(BIN),
        "-m", str(MODEL),
        "-f", str(wav),
        "-l", cfg["language"],
        "-t", str(cfg["threads"]),
        "-bs", "1",
        "-bo", "1",
        "-nt",
        "-sns",
        "-otxt",
        "-of", str(out_base),
        "-nth", "0.6",
    ]
    started = time.monotonic()
    env = os.environ.copy()
    env["VK_ICD_FILENAMES"] = "/usr/share/vulkan/icd.d/freedreno_icd.aarch64.json"
    env["VK_LOADER_LAYERS_DISABLE"] = "~implicit~"
    env["GGML_VK_PREFER_HOST_MEMORY"] = "1"
    proc = subprocess.run(
        cmd,
        capture_output=True,
        text=True,
        timeout=90,
        check=False,
        env=env,
    )
    elapsed = time.monotonic() - started
    err_path = STATE / "last-whisper.log"
    err_path.write_text(proc.stderr or "")
    text = txt.read_text(errors="replace") if txt.exists() else ""
    log(f"whisper exit {proc.returncode} in {elapsed:.1f}s")
    if proc.returncode != 0:
        tail = "\n".join((proc.stderr or "").splitlines()[-8:])
        log(tail)
        return None
    return text


